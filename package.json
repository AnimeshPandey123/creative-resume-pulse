{
  "name": "animesh-pandey-portfolio",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "dev:static": "mv next.config.ts next.config.dev.ts && mv next.config.static.ts next.config.ts && next dev",
    "dev:server": "mv next.config.ts next.config.static.ts && mv next.config.dev.ts next.config.ts && next dev",
    "build": "npm run test:ci && next build",
    "build:static": "mv next.config.ts next.config.dev.ts && mv next.config.static.ts next.config.ts && next build",
    "build:server": "mv next.config.ts next.config.static.ts && mv next.config.dev.ts next.config.ts && next build",
    "start": "next start",
    "preview": "npm run build && npx serve@latest .next/server/app",
    "export": "npm run build && cp -r .next/server/app out",
    "serve-export": "npm run export && npx serve@latest out",
    "lint": "eslint . --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:seo": "jest --testPathPattern=seo",
    "test:pages": "jest --testPathPattern=__tests__",
    "test:all": "jest --testPathPattern='(seo|__tests__)'",
    "test:ci": "NODE_ENV=test REACT_APP_ENV=test jest --config jest.config.ci.js"
  },
  "dependencies": {
