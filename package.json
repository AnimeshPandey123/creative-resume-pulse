  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^14.3.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "chalk": "^5.6.0",
    "commander": "^14.0.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "openai": "^6.49.0",
    "prettier": "^3.6.2",
    "slugify": "^1.6.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "prismjs": ">=1.30.0",
    "postcss": ">=8.5.31",
    "sharp": ">=0.35.5",
    "katex": ">=0.18.2",
    "browserslist": ">=4.28.7",
    "nanoid": ">=3.3.18 <4",
    "source-map-js": ">=1.2.2",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "js-yaml": "4.3.2",
    "postcss-selector-parser": "7.1.7",
    "deepmerge": "npm:@stackline/deepmerge@1.1.0",
    "glob": "14.0.3",
    "minimatch": "11.0.3",
    "zod": "4.6.7"
  }
}
