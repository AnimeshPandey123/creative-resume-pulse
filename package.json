{
  "name": "animesh-pandey-portfolio",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "dev:static": "mv next.config.ts next.config.dev.ts && mv next.config.static.ts next.config.ts && next dev",
    "dev:server": "mv next.config.ts next.config.static.ts && mv next.config.dev.ts next.config.ts && next dev",
    "build": "npm run audit && npm run lint && next build",
    "audit": "npm audit",
    "build:static": "mv next.config.ts next.config.dev.ts && mv next.config.static.ts next.config.ts && next build",
    "build:server": "mv next.config.ts next.config.dev.ts && mv next.config.static.ts next.config.ts && next build",
    "start": "npx serve@latest out -c ../serve.json",
    "preview": "npm run build && npx serve@latest .next/server/app",
    "export": "npm run build && cp -r .next/server/app out",
    "serve-export": "npm run export && npx serve@latest out -c ../serve.json",
    "lint": "eslint . --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:seo": "jest --testPathPatterns=seo",
    "test:pages": "jest --testPathPatterns=__tests__",
    "test:all": "jest --testPathPatterns='(seo|__tests__)'",
    "test:ci": "NODE_ENV=test REACT_APP_ENV=test jest --config jest.config.ci.js --coverage",
    "generate-blog": "npx tsx scripts/generate-blog.ts",
    "sync-blog": "npx tsx scripts/sync-blog-data.ts",
    "demo": "npx tsx scripts/demo.ts",
    "test-rss": "npx tsx scripts/test-rss-feed.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@hotjar/browser": "^1.0.9",
    "@next/third-parties": "^15.5.28",
